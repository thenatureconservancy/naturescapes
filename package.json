{
  "name": "mapbox-vue-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@mapbox/search-js-web": "^1.5.1",
    "@quasar/extras": "^1.18.0",
    "@turf/turf": "^7.3.5",
    "mapbox-gl": "^3.20.0",
    "papaparse": "^5.5.4",
    "pdfmake": "^0.3.11",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.11.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.35.0",
    "oxlint": "~1.50.0",
    "sass": "^1.99.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
